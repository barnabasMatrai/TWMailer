{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug twmailer",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/twmailer-server",
            "args": ["6543", "spooldir"],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "make",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "stopAtEntry": false,
            "externalConsole": false
        }
    ]
}